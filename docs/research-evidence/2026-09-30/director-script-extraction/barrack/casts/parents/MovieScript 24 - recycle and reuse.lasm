  [ 49] pushint8 1 .............................. <1>
  [ 51] add ..................................... <gmodinc + 1>
  [ 52] setglobal 49 ............................ gmodinc = gmodinc + 1
  [ 54] jmp [ 76]
  [ 57] getglobal 51 ............................ <gshaders>
