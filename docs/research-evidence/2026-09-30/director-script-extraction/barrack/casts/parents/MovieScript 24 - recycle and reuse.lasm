  [ 67] getglobal 51 ............................ <gshaders>
  [ 69] pushint8 1 .............................. <1>
  [ 71] pusharglistnoret 2 ...................... <gshaders, 1>
  [ 73] objcall 568 ............................. gshaders.deleteAt(1)
  [ 76] getlocal 0 .............................. <sha>
  [ 78] getparam 0 .............................. <nam>
  [ 80] pusharglist 1 ........................... <nam>
  [ 82] extcall 29 .............................. <texy(nam)>
  [ 84] setobjprop 68 ........................... sha.texture = texy(nam)
  [ 86] getlocal 0 .............................. <sha>
  [ 88] getchainedprop 518 ...................... <sha.textureTransform>
  [ 91] pushint8 1 .............................. <1>
  [ 93] pushint8 1 .............................. <1>
  [ 95] pushint8 1 .............................. <1>
  [ 97] pusharglist 3 ........................... <1, 1, 1>
  [ 99] extcall 34 .............................. <vector(1, 1, 1)>
  [101] setobjprop 35 ........................... sha.textureTransform.scale = vector(1, 1, 1)
  [103] getlocal 0 .............................. <sha>
  [105] getchainedprop 518 ...................... <sha.textureTransform>
  [108] pushzero ................................ <0>
  [109] pushzero ................................ <0>
  [110] pushzero ................................ <0>
  [111] pusharglist 3 ........................... <0, 0, 0>
  [113] extcall 34 .............................. <vector(0, 0, 0)>
  [115] setobjprop 36 ........................... sha.textureTransform.position = vector(0, 0, 0)
  [117] getlocal 0 .............................. <sha>
  [119] pusharglistnoret 1 ...................... <sha>
  [121] extcall 37 .............................. return sha
  [123] ret
end

on storeshader nsha
  [  0] getglobal 51 ............................ <gshaders>
  [  2] getparam 0 .............................. <nsha>
  [  4] pusharglistnoret 2 ...................... <gshaders, nsha>
  [  6] objcall 223 ............................. gshaders.add(nsha)
  [  8] ret
end
