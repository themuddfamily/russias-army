  [ 22] setlocal 0 .............................. sha = gmem.newShader("shad" & gmodinc, #standard)
  [ 24] getlocal 0 .............................. <sha>
  [ 26] pushint16 255 ........................... <255>
  [ 29] pushint16 255 ........................... <255>
  [ 32] pushint16 255 ........................... <255>
  [ 35] pusharglist 3 ........................... <255, 255, 255>
  [ 37] extcall 69 .............................. <rgb(255, 255, 255)>
