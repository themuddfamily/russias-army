property pos, tarpos, bsp, speed, bon, pmod
global ghvk, gmem, gcam, gsoldiers

on new me, modo, npos
  [  0] getparam 1 .............................. <modo>
  [  2] setprop 218 ............................. pmod = modo
  [  4] getparam 2 .............................. <npos>
  [  6] setprop 108 ............................. pos = npos
  [  8] getprop 108 ............................. <pos>
  [ 10] pushcons 0 .............................. <"hurt">
  [ 12] pusharglistnoret 2 ...................... <pos, "hurt">
  [ 14] extcall 27 .............................. playsound(pos, "hurt")
  [ 16] getprop 108 ............................. <pos>
  [ 18] setprop 449 ............................. tarpos = pos
  [ 21] getprop 218 ............................. <pmod>
  [ 23] pushsymb 456 ............................ <#boundingSphere>
  [ 26] pushint8 2 .............................. <2>
  [ 28] pusharglist 3 ........................... <pmod, #boundingSphere, 2>
  [ 30] objcall 60 .............................. <pmod.boundingSphere[2]>
  [ 32] pushfloat32 0.75 ........................ <0.75>
  [ 37] mul ..................................... <pmod.boundingSphere[2] * 0.75>
  [ 38] setprop 132 ............................. bsp = pmod.boundingSphere[2] * 0.75
  [ 40] getprop 218 ............................. <pmod>
  [ 42] pusharglistnoret 1 ...................... <pmod>
  [ 44] objcall 394 ............................. pmod.removeFromWorld()
  [ 47] pushzero ................................ <0>
  [ 48] setprop 458 ............................. bon = 0
  [ 51] getglobal 94 ............................ <gmem>
  [ 53] getprop 108 ............................. <pos>
  [ 55] pushzero ................................ <0>
  [ 56] pushzero ................................ <0>
  [ 57] pushint8 1 .............................. <1>
  [ 59] inv ..................................... <-1>
  [ 60] pusharglist 3 ........................... <0, 0, -1>
  [ 62] extcall 34 .............................. <vector(0, 0, -1)>
  [ 64] pushint8 1 .............................. <1>
  [ 66] pushsymb 414 ............................ <#detailed>
  [ 69] pusharglist 5 ........................... <gmem, pos, vector(0, 0, -1), 1, #detailed>
  [ 71] objcall 415 ............................. <gmem.modelsUnderRay(pos, vector(0, 0, -1), 1, #detailed)>
  [ 74] setlocal 0 .............................. hit = gmem.modelsUnderRay(pos, vector(0, 0, -1), 1, #detailed)
  [ 76] getlocal 0 .............................. <hit>
  [ 78] getobjprop 59 ........................... <hit.count>
  [ 80] pushzero ................................ <0>
  [ 81] gt ...................................... <hit.count > 0>
  [ 82] jmpifz [108] ............................ if hit.count > 0 then
  [ 85] getlocal 0 .............................. <hit>
  [ 87] pushint8 1 .............................. <1>
  [ 89] pusharglist 2 ........................... <hit, 1>
  [ 91] objcall 217 ............................. <hit[1]>
  [ 93] getobjprop 416 .......................... <hit[1].isectPosition>
  [ 96] pushzero ................................ <0>
  [ 97] pushzero ................................ <0>
  [ 98] getprop 132 ............................. <bsp>
  [100] pusharglist 3 ........................... <0, 0, bsp>
  [102] extcall 34 .............................. <vector(0, 0, bsp)>
  [104] add ..................................... <hit[1].isectPosition + vector(0, 0, bsp)>
  [105] setprop 449 ............................. tarpos = hit[1].isectPosition + vector(0, 0, bsp)
  [108] pushzero ................................ <0>
  [109] pushzero ................................ <0>
  [110] getprop 132 ............................. <bsp>
  [112] inv ..................................... <-bsp>
  [113] pusharglist 3 ........................... <0, 0, -bsp>
  [115] extcall 34 .............................. <vector(0, 0, -bsp)>
  [117] pushint16 300 ........................... <300>
  [120] div ..................................... <vector(0, 0, -bsp) / 300>
  [121] setprop 453 ............................. speed = vector(0, 0, -bsp) / 300
  [124] getprop 218 ............................. <pmod>
  [126] getchainedprop 96 ....................... <pmod.transform>
  [128] getprop 108 ............................. <pos>
  [130] setobjprop 36 ........................... pmod.transform.position = pos
  [132] getprop 218 ............................. <pmod>
  [134] pusharglistnoret 1 ...................... <pmod>
  [136] objcall 418 ............................. pmod.addToWorld()
  [139] getmovieprop 52 ......................... <the actorList>
  [141] getparam 0 .............................. <me>
  [143] pusharglistnoret 2 ...................... <the actorList, me>
  [145] objcall 223 ............................. (the actorList).add(me)
  [147] getparam 0 .............................. <me>
  [149] pusharglistnoret 1 ...................... <me>
  [151] extcall 37 .............................. return me
  [153] ret
end

on stepFrame me
  [  0] getprop 458 ............................. <bon>
  [  3] pushint8 8 .............................. <8>
  [  5] add ..................................... <bon + 8>
  [  6] setprop 458 ............................. bon = bon + 8
  [  9] getprop 218 ............................. <pmod>
  [ 11] getchainedprop 96 ....................... <pmod.transform>
  [ 13] getprop 218 ............................. <pmod>
  [ 15] getchainedprop 96 ....................... <pmod.transform>
  [ 17] getobjprop 36 ........................... <pmod.transform.position>
  [ 19] getprop 453 ............................. <speed>
  [ 22] pushint8 8 .............................. <8>
  [ 24] mul ..................................... <speed * 8>
  [ 25] add ..................................... <pmod.transform.position + (speed * 8)>
  [ 26] setobjprop 36 ........................... pmod.transform.position = pmod.transform.position + (speed * 8)
  [ 28] getprop 218 ............................. <pmod>
  [ 30] getchainedprop 454 ...................... <pmod.bonesPlayer>
  [ 33] getprop 458 ............................. <bon>
  [ 36] pushint16 2400 .......................... <2400>
  [ 39] add ..................................... <bon + 2400>
  [ 40] setobjprop 467 .......................... pmod.bonesPlayer.currentTime = bon + 2400
  [ 43] getprop 458 ............................. <bon>
  [ 46] pushint16 600 ........................... <600>
  [ 49] gt ...................................... <bon > 600>
  [ 50] jmpifz [ 72] ............................ if bon > 600 then
  [ 53] pushsymb 452 ............................ <#GI>
  [ 56] getprop 218 ............................. <pmod>
  [ 58] pusharglistnoret 2 ...................... <#GI, pmod>
  [ 60] extcall 474 ............................. storemodel(#GI, pmod)
  [ 63] getmovieprop 52 ......................... <the actorList>
  [ 65] getparam 0 .............................. <me>
  [ 67] pusharglistnoret 2 ...................... <the actorList, me>
  [ 69] objcall 366 ............................. (the actorList).deleteOne(me)
  [ 72] ret
end

on hurt me, howbad
  [  0] ret
end
