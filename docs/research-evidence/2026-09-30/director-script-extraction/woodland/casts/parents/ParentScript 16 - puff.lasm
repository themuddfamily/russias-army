end

on hit me
  [  0] ret
end

on hurt me
  [  0] pushsymb 244 ............................ <#plane>
  [  2] getprop 67 .............................. <pmod>
  [  4] pusharglistnoret 2 ...................... <#plane, pmod>
  [  6] extcall 469 ............................. storemodel(#plane, pmod)
  [  9] getprop 67 .............................. <pmod>
