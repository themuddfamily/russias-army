  [ 46] pushzero ................................ <0>
  [ 47] pusharglistnoret 1 ...................... <0>
  [ 49] extcall 173 ............................. return 0
  [ 51] jmp [ 96]
  [ 54] getlocal 0 .............................. <vmods>
  [ 56] pushint8 1 .............................. <1>
  [ 58] pusharglist 2 ........................... <vmods, 1>
  [ 60] objcall 63 .............................. <vmods[1]>
  [ 62] setlocal 1 .............................. vmod = vmods[1]
  [ 64] getlocal 1 .............................. <vmod>
