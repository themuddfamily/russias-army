  [ 68] objcall 413 ............................. vmod.addToWorld()
  [ 71] getlocal 0 .............................. <vmods>
  [ 73] getlocal 1 .............................. <vmod>
  [ 75] pusharglistnoret 2 ...................... <vmods, vmod>
  [ 77] objcall 155 ............................. vmods.deleteOne(vmod)
  [ 79] getglobal 164 ........................... <grecmods>
  [ 81] getparam 0 .............................. <ntype>
  [ 83] getlocal 0 .............................. <vmods>
  [ 85] pusharglistnoret 3 ...................... <grecmods, ntype, vmods>
