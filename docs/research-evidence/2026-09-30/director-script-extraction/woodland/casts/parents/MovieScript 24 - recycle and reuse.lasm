  [ 13] setlocal 1 .............................. vmods = grecmods.getaProp(ntype)
  [ 15] getlocal 1 .............................. <vmods>
  [ 17] pushzero ................................ <0>
  [ 18] eq ...................................... <vmods = 0>
  [ 19] jmpifz [ 38] ............................ if vmods = 0 then / else
  [ 22] getglobal 164 ........................... <grecmods>
  [ 24] getparam 0 .............................. <ntype>
  [ 26] getparam 1 .............................. <nmod>
  [ 28] pusharglist 1 ........................... <[nmod]>
  [ 30] pushlist ................................ <[nmod]>
  [ 31] pusharglistnoret 3 ...................... <grecmods, ntype, [nmod]>
  [ 33] objcall 100 ............................. grecmods.addProp(ntype, [nmod])
  [ 35] jmp [ 57]
  [ 38] getlocal 1 .............................. <vmods>
  [ 40] getparam 1 .............................. <nmod>
  [ 42] pusharglistnoret 2 ...................... <vmods, nmod>
  [ 44] objcall 55 .............................. vmods.add(nmod)
  [ 46] getglobal 164 ........................... <grecmods>
  [ 48] getparam 0 .............................. <ntype>
  [ 50] getlocal 1 .............................. <vmods>
  [ 52] pusharglistnoret 3 ...................... <grecmods, ntype, vmods>
  [ 54] objcall 395 ............................. grecmods.setaProp(ntype, vmods)
  [ 57] getparam 1 .............................. <nmod>
  [ 59] pusharglistnoret 1 ...................... <nmod>
  [ 61] objcall 391 ............................. nmod.removeFromWorld()
  [ 64] ret
end

on recyclemodel ntype
  [  0] getglobal 164 ........................... <grecmods>
  [  2] getparam 0 .............................. <ntype>
  [  4] pusharglist 2 ........................... <grecmods, ntype>
