{
  "name": "russias-army-remastered",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/run-bounded.sh --server vite --host 0.0.0.0 --port 8859",
    "server": "bash scripts/run-bounded.sh --server tsx server/index.ts",
    "dev:multi": "concurrently -k -n WEB,ROOMS \"npm:dev\" \"npm:server\"",
    "build": "bash scripts/run-bounded.sh bash -c 'tsc --noEmit && tsc -p server/tsconfig.json --noEmit && vite build'",
    "preview": "bash scripts/run-bounded.sh --server vite preview --host 0.0.0.0",
    "test": "bash scripts/run-bounded.sh bash -c 'vitest run && vitest run --config server/vitest.config.ts'",
    "test:server": "bash scripts/run-bounded.sh vitest run --config server/vitest.config.ts",
    "test:e2e": "bash scripts/run-bounded.sh playwright test",
    "trial": "bash scripts/run-bounded.sh tsx"
  },
  "dependencies": {
    "three": "^0.178.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.178.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
